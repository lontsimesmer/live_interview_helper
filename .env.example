# GEMINI_API_KEY: Required for Gemini AI Live Voice & Resume Analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Database for Customer Service Questions & Interview Sessions)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Optional: Personal Access Token from https://supabase.com/dashboard/account/tokens to auto-create tables on server start
SUPABASE_ACCESS_TOKEN="sbp_your_personal_access_token"

# BREVO CONFIGURATION (Transactional Email API for Sending Assessment Results & Transcript)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="interviews@globalhire360.com"
BREVO_SENDER_NAME="Global Hire 360 Interview Platform"
