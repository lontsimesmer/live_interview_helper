# GEMINI_API_KEY: Required for Gemini AI Live Voice & Resume Analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Gemini Live model for Sarah's voice, tried before the built-in list in
# interviewer-agent.ts (gemini-3.1-flash-live-preview, gemini-3.8-live, ...).
# GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Database for Customer Service Questions & Interview Sessions)
SUPABASE_URL="https://your-project-id.supabase.co"
# REQUIRED for the backend: the hardened schema blocks the anon key from all tables.
# Server-side only — never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Optional/legacy: not used for writes anymore.
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Optional: Personal Access Token from https://supabase.com/dashboard/account/tokens to auto-create tables on server start
SUPABASE_ACCESS_TOKEN="sbp_your_personal_access_token"

# RESEND CONFIGURATION (Transactional Email API for Sending Assessment Results & Transcript)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="interviews@globalhire360.com"
RESEND_FROM_NAME="Global Hire 360 Interview Coach"


# ADMIN API KEY (protects /api/candidates, /api/customer-service-questions, /api/supabase/*)
# Send it as the "x-admin-key" header. Use a long random value (>= 16 chars), e.g. `openssl rand -base64 32`.
# If unset, those admin endpoints are disabled.
ADMIN_API_KEY=""
